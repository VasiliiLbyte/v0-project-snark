# Скопировать этот файл в .env на сервере и заполнить значения
# cp .env.production.example .env

NODE_ENV=production

# Mock на проде ЗАПРЕЩЁН. Должно быть false (или переменная отсутствует).
# USE_MOCK_DB=true при NODE_ENV=production → приложение падает на старте.
USE_MOCK_DB=false

# Cookie Secure:
# - true  — если есть HTTPS (рекомендуется)
# - false — HTTP за NSSM без TLS-терминации (логин иначе ломается)
COOKIE_SECURE=false

# PostgreSQL (приложение)
DATABASE_URL=postgres://portal_user:CHANGE_ME@localhost:5432/snark_portal

# PostgreSQL (docker compose, если используется)
POSTGRES_PASSWORD=замените_на_сложный_пароль_минимум_20_символов

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=замените_на_сложный_пароль_минимум_20_символов
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central-1
S3_BUCKET=snark-portal
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# JWT — генерируются командой: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Домен (без https://)
DOMAIN=portal.your-company.ru

# Python-сервис протоколов
PROTOCOLS_API_URL=http://localhost:8000
